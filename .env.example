# Postgres (Neon pooled connection string, ends with ?sslmode=require)
DATABASE_URL=
# Jupiter developer key (developers.jup.ag/portal). Optional, raises rate limits.
JUPITER_API_KEY=
# Requests per second your Jupiter plan allows (free = 1, Developer = 10). Shared by every process using the key.
JUPITER_RPS=1
# Helius key (dashboard.helius.dev). Used to verify trades on Solana.
HELIUS_API_KEY=
